library(tidyverse)
library(ggplot2)
library(patchwork)
# ── Build year-by-year data ───────────────────────────────────────────────────
horizon <- 100
discount_df <- tibble(t = 0:horizon) %>%
mutate(
# ── OMB stepping rate ───────────────────────────────────────────────────
rate_OMB = case_when(
t <= 59 ~ 0.020,
t <= 74 ~ 0.019,
TRUE    ~ 0.018
),
# ── OMB discount factor (compounded year by year) ───────────────────────
factor_OMB = accumulate(rate_OMB, ~ .x / (1 + .y), .init = 1)[-1] %>%
c(1, .),   # prepend t=0 factor of 1
# ── Single composite 2.9% factor ────────────────────────────────────────
factor_single = (1 / 1.029) ^ t,
# ── Pluralistic actual factor ────────────────────────────────────────────
# Capital composition: 40% natural @ 0%, 10% social @ 0%,
#                      30% human  @ 3%, 20% built  @ 10%
factor_pluralistic = 0.40 * (1 / 1.000) ^ t +
0.10 * (1 / 1.000) ^ t +
0.30 * (1 / 1.030) ^ t +
0.20 * (1 / 1.100) ^ t,
# Composite rate label for panel 1
rate_composite = 0.029
)
# Corrected pluralistic — human capital at 3%, natural at 0% (per Table 3, Option 1)
df_long$NPV_WTP_pluristic =
(df_long$wtp * df_long$pop * 0.4) / (1 + 0.03)^df_long$time_step +  # human: 3%
(df_long$wtp * df_long$pop * 0.1) / (1 + 0.00)^df_long$time_step +  # social: 0%
(df_long$wtp * df_long$pop * 0.3) / (1 + 0.00)^df_long$time_step +  # natural: 0%
(df_long$wtp * df_long$pop * 0.2) / (1 + 0.10)^df_long$time_step    # built: 10%
