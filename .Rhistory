ungroup() %>%
select(choice_id, id, chosen_park = parkname) %>%
expand_grid(parkname = physical_parks) %>%
mutate(choice = (chosen_park == parkname)) %>%
left_join(current_data %>% select(id, parkname, price), by = c("id", "parkname"))
# 2. Add Outside Option
outside_home <- data_rum_raw %>%
distinct(choice_id, id) %>%
mutate(parkname = "Stay_Home", choice = FALSE, price = 0)
data_rum_combined <- bind_rows(data_rum_raw, outside_home)
# 3. Model Estimation with Error Handling (Fixes the 2020 crash)
df_idx_local <- dfidx(data_rum_combined, idx = list("choice_id", "parkname"), shape = "long")
rum_mle <- tryCatch({
mlogit(choice ~ price | 1, data = df_idx_local, method = "nr")
}, error = function(e) {
# Try BHHH method if NR fails (common in 2020 data)
message("NR failed, trying BHHH solver...")
mlogit(choice ~ price | 1, data = df_idx_local, method = "bhhh")
})
model_list_obs[[paste0("Year_", yr)]] <<- rum_mle
# 4. Prepare Math Data for this specific year
df_math_local <- as.data.frame(df_idx_local)
df_math_local$trip_id   <- as.character(idx(df_idx_local, 1))
df_math_local$park_name <- as.character(idx(df_idx_local, 2))
df_math_local$V <- as.numeric(model.matrix(rum_mle) %*% coef(rum_mle))
# 5. RUM Welfare Calculation (Now includes Stay_Home)
rum_results <- map_df(parks_to_test, function(p) {
res <- calc_rum_welfare(p, rum_mle, df_math_local)
res$parkname <- p
return(res)
})
# 6. Bring in MDCEV Data (Using Site 22 for Stay_Home)
mdcev_indiv <- read_csv(paste0("data/welfare_", yr, "_ind.csv"), show_col_types = FALSE) %>%
left_join(site_lookup, by = "site") %>%
mutate(id = as.character(id)) %>%
select(id, parkname, mdcev_annual_loss = mean_value) %>%
filter(!is.na(parkname)) # Remove sites not in our lookup
# 7. Final Join
year_comparison <- rum_results %>%
left_join(mdcev_indiv, by = c("id", "parkname")) %>%
left_join(unique_users, by = "id") %>%
mutate(
year = yr,
difference = annual_rum_loss - mdcev_annual_loss
)
return(year_comparison)
})
#| cache: true
#| message: false
#| warning: false
#| code-fold: true
#| code-summary: "Show the Code"
years <- 2018:2023
#  Same Mcfadden and coefficient holders
model_list_52  <- list()
mcfadden_list_52 <- list()
#Welfare Function ---
calc_rum_welfare_per_person <- function(target_park, current_mle, current_math_df) {
beta_price <- coef(current_mle)["price"]
welfare_by_id <- current_math_df %>%
group_by(trip_id) %>%
summarise(
ls_base = log(sum(exp(V))),
ls_policy = log(sum(exp(V[park_name != target_park]))),
.groups = "drop"
) %>%
mutate(cv_week = (ls_policy - ls_base) / -beta_price) %>%
mutate(id = as.character(str_remove(trip_id, "_w\\d+$"))) %>%
group_by(id) %>%
summarise(annual_rum_loss = sum(cv_week, na.rm = TRUE), .groups = "drop")
return(welfare_by_id)
}
# --- 2. Main Loop ---
final_comparison_52_person <- map_df(years, function(yr) {
message(paste(">>> Processing Year (52-week):", yr))
current_data <- get(paste0("final_data_", yr))
# Setup a 52 week decision
unique_users <- current_data %>%
group_by(id) %>%
summarise(zip = first(zip), income = first(income), .groups = "drop") %>%
mutate(id = as.character(id))
all_parks <- unique(current_data$parkname)
# --- SITE LOOKUP: Force Stay_Home to Site 22 ---
site_lookup <- data.frame(
site = seq_along(all_parks),
parkname = all_parks
) %>%
bind_rows(data.frame(site = 22, parkname = "Stay_Home"))
# Ensure "Stay_Home" is in the welfare test list
parks_to_test <- site_lookup$parkname
# Expand to 52 Weeks
df_52_weeks <- unique_users %>%
expand_grid(week = 1:52) %>%
mutate(choice_id = paste0(id, "_w", week))
actual_trips <- current_data %>%
filter(VisitCount > 0) %>%
uncount(VisitCount) %>%
group_by(id) %>%
mutate(week = row_number()) %>%
filter(week <= 52) %>%
ungroup() %>%
select(id, week, chosen_park = parkname) %>%
mutate(id = as.character(id))
# 2. Build Choice Set
df_rum_final <- df_52_weeks %>%
left_join(actual_trips, by = c("id", "week")) %>%
mutate(chosen_park = replace_na(chosen_park, "Stay_Home")) %>%
expand_grid(parkname = c(all_parks, "Stay_Home")) %>%
mutate(choice = (chosen_park == parkname)) %>%
left_join(current_data %>% mutate(id = as.character(id)) %>% select(id, parkname, price),
by = c("id", "parkname")) %>%
mutate(price = replace_na(price, 0))
# Model Estimation with tryCatch (Fixes 2020 error)
df_idx_local <- dfidx(df_rum_final, idx = list("choice_id", "parkname"), shape = "long")
rum_mle_52 <- tryCatch({
mlogit(choice ~ price | 1 , data = df_idx_local, method = "nr")
}, error = function(e) {
message("NR Solver failed, trying BHHH...")
mlogit(choice ~ price | 1 , data = df_idx_local, method = "bhhh")
})
model_list_52[[paste("52wk", yr)]] <<- rum_mle_52
# McFadden R2 calculation
rum_null <- mlogit(choice ~ 1 | 1, data = df_idx_local)
ll_mod  <- as.numeric(logLik(rum_mle_52))
ll_null <- as.numeric(logLik(rum_null))
mcf_r2  <- 1 - (ll_mod / ll_null)
mcfadden_list_52[[paste("52weeks", yr)]] <<- format(round(mcf_r2, 3), nsmall = 3)
df_math_local <- as.data.frame(df_idx_local)
df_math_local$trip_id   <- as.character(idx(df_idx_local, 1))
df_math_local$park_name <- as.character(idx(df_idx_local, 2))
df_math_local$V <- as.numeric(model.matrix(rum_mle_52) %*% coef(rum_mle_52))
# RUM Welfare Calculations (Including Stay_Home)
rum_person_results <- map_df(parks_to_test, function(p) {
res <- calc_rum_welfare_per_person(p, rum_mle_52, df_math_local)
res$parkname <- p
return(res)
})
# Bring in MDCEV Individual Welfare
mdcev_indiv <- read_csv(paste0("data/welfare_", yr, "_ind.csv"), show_col_types = FALSE) %>%
left_join(site_lookup, by = "site") %>%
mutate(id = as.character(id)) %>%
select(id, parkname, mdcev_annual_loss = mean_value) %>%
filter(!is.na(parkname)) # Ensures we only keep matched sites
# Final Join
year_comparison <- rum_person_results %>%
left_join(mdcev_indiv, by = c("id", "parkname")) %>%
left_join(unique_users, by = "id") %>%
mutate(
year = yr,
difference = annual_rum_loss - mdcev_annual_loss
)
return(year_comparison)
})
write_csv(model_list_obs, "data/model_list_obs.csv")
saveRDS(model_list_obs, "data/model_list_obs.rds")
saveRDS(model_list_52, "data/model_list_52s.rds")
model_list_obs <- readRDS("data/model_list_obs.rds")
model_list_52s <- readRDS("data/model_list_52s.rds")
saveRDS(model_list_52, "data/model_list_52.rds")
library(tidyverse)
library(ggplot2)
library(knitr)
library(kableExtra)
horizon <- 100
# ── Build data ────────────────────────────────────────────────────────────────
discount_df <- tibble(t = 0:horizon) %>%
mutate(
rate_OMB = case_when(
t <= 59 ~ 0.020,
t <= 74 ~ 0.019,
TRUE    ~ 0.018
),
rate_pluralistic   = 0.029,
factor_pluralistic = 0.40 * (1 / 1.000) ^ t +
0.10 * (1 / 1.000) ^ t +
0.30 * (1 / 1.030) ^ t +
0.20 * (1 / 1.100) ^ t
)
# OMB factor compounded year-by-year (rate changes at two thresholds)
factor_OMB_vec <- numeric(horizon + 1)
factor_OMB_vec[1] <- 1
for (i in 2:(horizon + 1)) {
factor_OMB_vec[i] <- factor_OMB_vec[i - 1] / (1 + discount_df$rate_OMB[i])
}
discount_df$factor_OMB <- factor_OMB_vec
# ══ TABLE: every year for appendix ════════════════════════════════════════════
appendix_table <- discount_df %>%
filter(t > 0) %>%
transmute(
Year                        = t,
`OMB rate (%)`              = scales::percent(rate_OMB, accuracy = 0.1),
`OMB discount factor`       = round(factor_OMB, 4),
`Pluralistic rate (%)`      = scales::percent(rate_pluralistic, accuracy = 0.1),
`Pluralistic discount factor` = round(factor_pluralistic, 4)
)
appendix_table %>%
kable(
caption = "Table A.2. Annual discount rates and discount factors: OMB declining and pluralistic approaches",
align   = c("c", "c", "c", "c", "c")
) %>%
kable_styling(
bootstrap_options = c("striped", "condensed"),
full_width        = FALSE,
font_size         = 11
) %>%
row_spec(which(appendix_table$Year %in% c(60, 75)),
bold = TRUE, background = "#f0f4ff") %>%
footnote(
general = paste(
"OMB rate follows OMB Circular A-4 (2023): 2.0% years 1-59, 1.9% years 60-74, 1.8% years 75+.",
"Pluralistic rate is a weighted composite: 0.40(0%) + 0.10(0%) + 0.30(3%) + 0.20(10%) = 2.9%",
"(Costanza et al., 2021). Note: 50% of welfare (natural and social capital components)",
"carries a 0% rate and is not discounted."
),
general_title = ""
)
# Also export as CSV
write_csv(appendix_table, "Table_A2_discount_rates_factors.csv")
# ══ FIGURE: Discount factors only (OMB and pluralistic) ═══════════════════════
plot_df <- discount_df %>%
pivot_longer(
cols      = c(factor_OMB, factor_pluralistic),
names_to  = "approach",
values_to = "factor"
) %>%
mutate(
approach = recode(approach,
factor_OMB         = "OMB declining discount rate",
factor_pluralistic = "Pluralistic discount rate")
)
library(tidyverse)
library(ggplot2)
library(patchwork)
horizon <- 100
discount_df <- tibble(t = 0:horizon) %>%
mutate(
rate_OMB = case_when(
t <= 59 ~ 0.020,
t <= 74 ~ 0.019,
TRUE    ~ 0.018
),
factor_single      = (1 / 1.029) ^ t,
factor_pluralistic = 0.40 * (1 / 1.000) ^ t +
0.10 * (1 / 1.000) ^ t +
0.30 * (1 / 1.030) ^ t +
0.20 * (1 / 1.100) ^ t,
rate_composite     = 0.029
)
# Compute OMB factor via loop (needed because rate changes at two thresholds)
factor_OMB_vec <- numeric(horizon + 1)
factor_OMB_vec[1] <- 1
for (i in 2:(horizon + 1)) {
factor_OMB_vec[i] <- factor_OMB_vec[i - 1] / (1 + discount_df$rate_OMB[i])
}
discount_df$factor_OMB <- factor_OMB_vec
# ── Year-50 values for annotations ───────────────────────────────────────────
yr50 <- discount_df %>% filter(t == 50)
# ══ PANEL 1: Discount rates ═══════════════════════════════════════════════════
p1 <- discount_df %>%
filter(t > 0) %>%
pivot_longer(c(rate_OMB, rate_composite),
names_to  = "approach",
values_to = "rate") %>%
mutate(
approach = recode(approach,
rate_OMB       = "OMB declining (2% → 1.9% → 1.8%)",
rate_composite = "Pluralistic composite (2.9%)")
) %>%
ggplot(aes(x = t, y = rate * 100, colour = approach, linetype = approach)) +
geom_vline(xintercept = c(60, 75), linetype = "dotted",
colour = "grey70", linewidth = 0.4) +
geom_line(linewidth = 0.9) +
annotate("text", x = 62, y = 2.6, label = "→ 1.9%",
hjust = 0, size = 3, colour = "grey50") +
annotate("text", x = 77, y = 2.4, label = "→ 1.8%",
hjust = 0, size = 3, colour = "grey50") +
annotate("text", x = 5,  y = 3.05,
label = "OMB always below 2.9% — no crossover",
hjust = 0, size = 3, colour = "grey40", fontface = "italic") +
scale_colour_manual(values = c(
"OMB declining (2% → 1.9% → 1.8%)" = "#185FA5",
"Pluralistic composite (2.9%)"      = "#639922"
)) +
scale_linetype_manual(values = c(
"OMB declining (2% → 1.9% → 1.8%)" = "solid",
"Pluralistic composite (2.9%)"      = "dashed"
)) +
scale_y_continuous(labels = scales::label_percent(scale = 1, accuracy = 0.1),
limits = c(0, 4), breaks = seq(0, 4, 0.5)) +
scale_x_continuous(breaks = seq(0, horizon, 10)) +
labs(
title    = "Panel 1 — Discount rates over time",
subtitle = "Reviewer's suggested graph: OMB is always below 2.9%; the crossover they expect does not exist",
x = NULL, y = "Discount rate (%)", colour = NULL, linetype = NULL
) +
theme_minimal(base_size = 11) +
theme(legend.position  = "bottom",
panel.grid.minor = element_blank(),
plot.subtitle    = element_text(size = 9, colour = "grey50"),
legend.text      = element_text(size = 9))
library(tidyverse)
library(ggplot2)
library(patchwork)
# ── Build year-by-year data ───────────────────────────────────────────────────
horizon <- 100
discount_df <- tibble(t = 0:horizon) %>%
mutate(
# ── OMB stepping rate ───────────────────────────────────────────────────
rate_OMB = case_when(
t <= 59 ~ 0.020,
t <= 74 ~ 0.019,
TRUE    ~ 0.018
),
# ── OMB discount factor (compounded year by year) ───────────────────────
factor_OMB = accumulate(rate_OMB, ~ .x / (1 + .y), .init = 1)[-1] %>%
c(1, .),   # prepend t=0 factor of 1
# ── Single composite 2.9% factor ────────────────────────────────────────
factor_single = (1 / 1.029) ^ t,
# ── Pluralistic actual factor ────────────────────────────────────────────
# Capital composition: 40% natural @ 0%, 10% social @ 0%,
#                      30% human  @ 3%, 20% built  @ 10%
factor_pluralistic = 0.40 * (1 / 1.000) ^ t +
0.10 * (1 / 1.000) ^ t +
0.30 * (1 / 1.030) ^ t +
0.20 * (1 / 1.100) ^ t,
# Composite rate label for panel 1
rate_composite = 0.029
)
library(tidyverse)
library(ggplot2)
library(knitr)
library(kableExtra)
# ── Define time horizon ────────────────────────────────────────────────────────
start_year <- 2021
end_year   <- 2120   # adjust to match your actual horizon
discount_df <- tibble(Year = start_year:end_year) %>%
mutate(
# ── Replicate your time_step logic ────────────────────────────────────────
raw_step  = Year - 2020,
time_step = case_when(
raw_step %in% 1:5 ~ 0,
raw_step >= 6     ~ raw_step - 5,
TRUE              ~ raw_step
),
# ── OMB declining rate (matches your NPV column) ──────────────────────────
rate_OMB = case_when(
Year <= 2079 ~ 0.020,
Year <= 2094 ~ 0.019,
TRUE         ~ 0.018
),
# ── Pluralistic composite rate (constant 2.9%) ────────────────────────────
rate_pluralistic = 0.029,
# ── Discount FACTORS for each year (useful to show in table) ──────────────
factor_OMB         = 1 / (1 + rate_OMB)^time_step,
factor_pluralistic = 1 / (1 + rate_pluralistic)^time_step
)
# ══ POINT 4: Year-by-year discount rate table ════════════════════════════════
discount_table <- discount_df %>%
select(Year, time_step,
`OMB Rate`         = rate_OMB,
`Pluralistic Rate` = rate_pluralistic,
`OMB Discount Factor`         = factor_OMB,
`Pluralistic Discount Factor` = factor_pluralistic) %>%
mutate(
`OMB Rate`         = scales::percent(`OMB Rate`, accuracy = 0.1),
`Pluralistic Rate` = scales::percent(`Pluralistic Rate`, accuracy = 0.1),
across(ends_with("Factor"), ~round(.x, 4))
)
# Print as a formatted table (use kableExtra for Word/PDF export)
discount_table %>%
kable(caption = "Annual Discount Rates and Discount Factors: OMB Declining vs. Pluralistic (2.9%) Approaches",
align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE) %>%
row_spec(which(discount_df$Year %in% c(2079, 2094)),   # highlight rate-change years
bold = TRUE, background = "#fff3cd")
# Also export as CSV for supplementary materials
write_csv(discount_df %>%
select(Year, time_step, rate_OMB, rate_pluralistic,
factor_OMB, factor_pluralistic),
"discount_rate_table.csv")
# ══ POINT 5: Line graph comparing the two schedules ══════════════════════════
# Find crossover year where OMB rate drops below pluralistic rate
crossover <- discount_df %>%
filter(rate_OMB < rate_pluralistic) %>%
slice(1) %>%
pull(Year)
# Long format for ggplot
plot_df <- discount_df %>%
select(Year,
`OMB Declining Rate`      = rate_OMB,
`Pluralistic Rate (2.9%)` = rate_pluralistic) %>%
pivot_longer(-Year, names_to = "Approach", values_to = "Rate")
# Shading data: period where OMB > pluralistic vs OMB < pluralistic
shade_above <- data.frame(
xmin = start_year, xmax = crossover,
ymin = -Inf,        ymax = Inf
)
shade_below <- data.frame(
xmin = crossover,  xmax = end_year,
ymin = -Inf,        ymax = Inf
)
ggplot(plot_df, aes(x = Year, y = Rate * 100, color = Approach, linetype = Approach)) +
# Shaded regions to show which rate is higher
geom_rect(data = shade_above, inherit.aes = FALSE,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
fill = "#d4e8f5", alpha = 0.3) +
geom_rect(data = shade_below, inherit.aes = FALSE,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
fill = "#fde8d4", alpha = 0.3) +
geom_line(linewidth = 1.1) +
# Crossover annotation
geom_vline(xintercept = crossover, linetype = "dashed",
color = "grey40", linewidth = 0.7) +
annotate("text", x = crossover + 1, y = 3.5,
label = paste0("Crossover: ", crossover),
hjust = 0, size = 3.5, color = "grey30") +
# Rate-change step annotations for OMB
geom_vline(xintercept = c(2080, 2095), linetype = "dotted",
color = "steelblue", linewidth = 0.5) +
annotate("text", x = 2080 + 0.5, y = 1.5,
label = "Rate → 1.9%", hjust = 0, size = 3, color = "steelblue") +
annotate("text", x = 2095 + 0.5, y = 1.3,
label = "Rate → 1.8%", hjust = 0, size = 3, color = "steelblue") +
scale_color_manual(values = c("OMB Declining Rate"      = "steelblue",
"Pluralistic Rate (2.9%)" = "darkorange")) +
scale_linetype_manual(values = c("OMB Declining Rate"      = "solid",
"Pluralistic Rate (2.9%)" = "dashed")) +
scale_y_continuous(labels = scales::label_number(suffix = "%"),
limits = c(0, 4),
breaks = seq(0, 4, 0.5)) +
scale_x_continuous(breaks = seq(start_year, end_year, 10)) +
labs(
title    = "Discount Rate Schedules: OMB Declining vs. Pluralistic Composite",
subtitle = paste0("OMB rate falls below the 2.9% pluralistic rate in ", crossover,
" (blue shading = OMB higher; orange = pluralistic higher)"),
x        = "Year",
y        = "Discount Rate (%)",
color    = "Approach",
linetype = "Approach",
caption  = "Pluralistic rate: 0.4(0%) + 0.1(0%) + 0.3(3%) + 0.2(10%) = 2.9% (Costanza et al., 2021)\nOMB declining rates follow OMB Circular A-4 (2023)"
) +
theme_minimal(base_size = 12) +
theme(
legend.position   = "bottom",
plot.caption      = element_text(size = 8, color = "grey50"),
axis.text.x       = element_text(angle = 45, hjust = 1),
panel.grid.minor  = element_blank()
)
ggsave("discount_rate_comparison.png", width = 10, height = 6, dpi = 300)
